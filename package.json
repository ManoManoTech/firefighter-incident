{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "firefighter",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "cross-env NODE_ENV=production npm run build:js && npm run build:css",
    "dev:css": "tailwindcss -i src/firefighter/incidents/css_src/main.css --watch -o ./src/firefighter/incidents/static/css/main.min.css",
    "dev:js": "rollup -c -w --silent",
    "build:js": "rollup -c --silent",
    "build:css": "tailwindcss -i src/firefighter/incidents/css_src/main.css --minify -o ./src/firefighter/incidents/static/css/main.min.css"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@alpinejs/collapse": "^3.17.5",
    "@alpinejs/focus": "^3.17.5",
    "@alpinejs/morph": "^3.17.5",
    "alpinejs": "^3.17.5",
    "htmx.org": "^2.0.11",
    "hyperscript.org": "^0.9.94"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-inject": "^5.0.5",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.6.2",
    "clean-css-cli": "^5.6.3",
    "cross-env": "^10.1.0",
    "daisyui": "^5.7.50",
    "postcss": "^8.5.32",
    "postcss-import": "^17.0.1",
    "rollup": "^4.67.5",
    "rollup-plugin-string": "^3.0.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "tailwindcss": "^4.2.1"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    }
  }
}
